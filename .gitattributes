# Auto-detect text files and normalize line endings to LF in git
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF on checkout
*.go text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Declare files that will always have CRLF line endings on checkout (Windows scripts)
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote all binary files
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary
*.exe binary
*.dll binary
